PORT=4000
JWT_SECRET=change-me
# Local: Vite. Production: your Vercel URL (comma-separated if you have a custom domain too).
CLIENT_ORIGIN=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173

# Production: Supabase Postgres connection string (leave empty for local SQLite)
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# DATABASE_SSL=true

# Slack (optional — Bot API required for Approve/Reject buttons)
# Posts leave requests + leave-policy acknowledgements to the leave-approval channel.
SLACK_BOT_TOKEN=
SLACK_LEAVE_CHANNEL=
SLACK_SIGNING_SECRET=
# Fallback notify-only (no buttons):
SLACK_WEBHOOK_URL=
# Interactivity Request URL in Slack app:
#   https://YOUR_API_HOST/api/slack/interactions
# Bot scopes: chat:write, users:read, users:read.email
# Slack profile email must match portal manager/HR login email.

# Gmail SMTP no-reply notifications
# 1. Use a dedicated Gmail / Google Workspace mailbox (e.g. noreply@…)
# 2. Enable 2-Step Verification on that account
# 3. Google Account → Security → App passwords → generate for Mail
# 4. Put the 16-character app password in SMTP_PASS (not the account password)
# 5. Set MAIL_ENABLED=true
MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourcompany.com
SMTP_PASS=
MAIL_FROM="Ultrix Leave Portal <noreply@yourcompany.com>"

# eSSL / att4u biometric punch device (GetTransactionsLog SOAP)
ATT4U_ENABLED=true
ATT4U_SOAP_URL=http://att4u.com/stan/WebApiService.asmx
ATT4U_USER=Api
ATT4U_PASSWORD=
ATT4U_SERIAL=NFZ8245103695
ATT4U_PORTAL_URL=http://www.att4u.com/STAN
ATT4U_PORTAL_USER=essl
ATT4U_PORTAL_PASSWORD=
ATT4U_LOOKBACK_DAYS=7
# ATT4U_DEVICE_MAP=3010=Walter Michael Fernandes,3011=Madhav Ketan Sompura,22=Raushan Raj,3001=Ashish Mohapatra,3007=Yashi Mishra,3008=Siddharth Singh,093=Shreyansh Singhal,ST093=Shreyansh Singhal
ATT4U_POLL_MS=60000
ATT4U_BOOT_DELAY_MS=45000
# Punch-in after this IST time counts as late (by 11:30 inclusive = on time)
ATT4U_LATE_AFTER=11:30:00
